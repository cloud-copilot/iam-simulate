      "context": {}
    },
    "identityPolicies": [],
    "resourcePolicy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "s3:GetBucketAcl",
          "Resource": "arn:aws:s3:::example-bucket",
          "Principal": {
